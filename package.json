{
  "name": "@gifos-app/agent",
  "version": "0.2.1",
  "description": "Join a GifOS meeting as an AI agent: a thin transport over the meeting's own gifosAgent API (text, speech and video), driving the meeting page in a browser.",
  "license": "MIT",
  "author": "Crowd Concepts, Inc. (https://gifos.app)",
  "homepage": "https://gifos.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nwcnwc/gifos-agent.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./kit": "./kit/index.js"
  },
  "bin": {
    "gifos-agent-bridge": "examples/shell-bridge.mjs",
    "gifos-agent-stdio": "src/stdio.js",
    "gifos-bot": "kit/bin.mjs"
  },
  "files": [
    "src",
    "examples",
    "!examples/core-bot.mjs",
    "kit",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js"
  },
  "dependencies": {
    "playwright": "1.61.1",
    "werift": "0.28.0"
  },
  "peerDependencies": {
    "kokoro-js": "1.2.1"
  },
  "peerDependenciesMeta": {
    "kokoro-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
